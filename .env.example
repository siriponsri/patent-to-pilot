# Copy this example to .env only if .env does not already exist.
# Never put a real key in .env.example. The actual .env is PLAINTEXT, not encrypted.
# Explicit loading only: --env-file .env (after live budget/funding approval).
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY

# --- Google BigQuery (medtech time-machine data; see scripts/healthtech/bq_probe.py) ---
# Put these three lines in a SEPARATE file named .env.bigquery (git-ignored), NOT in .env:
# the .env loader accepts only OPENROUTER_API_KEY and would reject any other name.
# BigQuery query jobs do not accept a plain Google "API key". Use a service-account JSON key file
# kept OUTSIDE this repository, or leave GOOGLE_APPLICATION_CREDENTIALS empty to use gcloud
# application-default login on this machine.
# GOOGLE_CLOUD_PROJECT=REPLACE_WITH_YOUR_PROJECT_ID
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/User/.ptp-secrets/bigquery-service-account.json
# PTP_BQ_MAX_BYTES_BILLED=107374182400
