BEGIN:VEVENT
UID:tracka-annual-check@patent-to-pilot.github
DTSTAMP:20261128T182000Z
DTSTART;TZID=Asia/Bangkok:20271101T090000
DTEND;TZID=Asia/Bangkok:20271101T093000
SUMMARY:Track A: check automation still works
DESCRIPTION:Review recent Worker checks\, renew the GitHub secrets as neede
 d and verify the exact release pins.\nReplace VERSION_ID and OSF_UPDATE_4_
 FREEZE_SHA256 with the published values.\npython -m loe_bench.score_releas
 e --release 10.5281/zenodo.VERSION_ID --horizon 12 --out track-a-results -
 -freeze-sha256 OSF_UPDATE_4_FREEZE_SHA256\npython -m loe_bench.score_relea
 se --release 10.5281/zenodo.VERSION_ID --horizon 24 --out track-a-results
  --freeze-sha256 OSF_UPDATE_4_FREEZE_SHA256\nGuide: https://github.com/sir
 iponsri/patent-to-pilot/blob/main/docs/loe-bench/HOW-TO-SCORE-TRACK-A.md\n
 OSF registration: https://doi.org/10.17605/OSF.IO/P2SMD\nZenodo version DO
 I: https://doi.org/10.5281/zenodo.VERSION_ID (placeholder)
RRULE:FREQ=YEARLY
BEGIN:VALARM
