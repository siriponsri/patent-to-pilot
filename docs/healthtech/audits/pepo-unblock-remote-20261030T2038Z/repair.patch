@@ -0,0 +1,47 @@
+"""Offline regressions for the source-derived query metadata channel."""
+import json
+from pathlib import Path
+
+import pytest
+
+from patent_to_pilot.healthtech.abbott import build_abbott_case_inputs
+from patent_to_pilot.healthtech.engine import run_dossier, serialize_dossier, export_markdown
+from patent_to_pilot.healthtech.history import save_version, select_version
+from test_healthtech_repairs import _write_synthetic_abbott_cohort, _write_json
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+@pytest.mark.parametrize("purpose", ["product_display", "redistribution"])
+def test_external_query_metadata_follows_source_field_policy_after_reload(tmp_path, purpose):
+    cohort = _write_synthetic_abbott_cohort(tmp_path)
+    policies = json.loads((ROOT / "docs/healthtech/audits/luna-patent-dossiers-20261028-rights-cohort/rights-matrix.json").read_text())
+    for policy in policies["sources"]:
+        policy["intended_use"]["product_display"] = "ALLOWED"
+        policy["intended_use"]["redistribution"] = "ALLOWED"
+        policy["displayable_fields"] = ["trade_name"] if policy["source_id"] == "openfda-pma-records" else []
+    path = tmp_path / "rights.json"
+    _write_json(path, policies)
+    data = next(iter(build_abbott_case_inputs(cohort, rights_matrix_path=path).values()))
+    original = dict(data.query.company_metadata)
+    assert original["applicant"] == "ABBOTT MEDICAL"
+    query = data.query.model_copy(update={"company_metadata": {**original, "trade_name": "MitraClip", "unknown": "RESTRICTED-SENTINEL"}})
+    data = data.model_copy(update={"query": query})
+    dossier, _, _ = run_dossier(data, run_id="query-boundary", code_commit="test")
+    dossier = dossier.model_copy(update={"user_edits": {"notes": "independently authored note"}})
+    history = tmp_path / "history"
+    save_version(history, dossier)
+    restored = select_version(history)
+    local = serialize_dossier(restored)
+    external = serialize_dossier(restored, purpose=purpose)
+    assert local["query"]["company_metadata"] == dict(query.company_metadata)
+    assert external["query"]["company_metadata"] == {"trade_name": "MitraClip"}
+    assert external["user_edits"] == local["user_edits"]
+    assert "RESTRICTED-SENTINEL" not in json.dumps(external)
+    for language in ("en", "th"):
+        assert "RESTRICTED-SENTINEL" not in export_markdown(restored, language=language, purpose=purpose)
+
+    forged = restored.model_copy(update={"query": query.model_copy(update={"company_metadata": {"trade_name": "wrong source value"}})})
+    assert serialize_dossier(forged, purpose=purpose)["query"]["company_metadata"] == {}
+    missing = restored.model_copy(update={"query": query.model_copy(update={"company_source_id": "missing"})})
+    assert serialize_dossier(missing, purpose=purpose)["query"]["company_metadata"] == {}
