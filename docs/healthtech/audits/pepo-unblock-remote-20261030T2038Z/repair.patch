+@contextmanager
+def _writer_lock(root: Path):
+    """Process-owned OS lock: a crash releases it without deleting evidence.
+
+    The persistent marker is not a lease. The kernel lock, rather than a PID
+    or file age, decides whether another writer may enter.
+    """
+    with (root / ".writer.lock").open("a+b") as handle:
+        handle.seek(0, os.SEEK_END)
