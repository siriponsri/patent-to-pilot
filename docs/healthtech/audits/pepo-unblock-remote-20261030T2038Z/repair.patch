@@ -0,0 +1,102 @@
+"""Authored offline crash/concurrency cases for actual publication boundaries."""
+import json
+import multiprocessing
+
+import numpy as np
+import pytest
+
+from patent_to_pilot.evaluation.healthtech import vector_artifacts as artifacts
+
+
+class Encoder:
+    def __init__(self):
+        self.calls = 0
+
+    def encode(self, texts):
+        self.calls += 1
+        return np.asarray([[1.0, 0.0] for _ in texts], dtype="<f4"), len(texts)
+
+
+def _input(tmp_path):
+    path = tmp_path / "runtime.jsonl"
+    artifacts.export_runtime_text(
+        [{"item_id": "a", "text": "authored public test"}], path,
+        dataset_id="fixture", source_revision="r1", representation="text",
+    )
+    return path
+
+
+def _encode(runtime, bundle, encoder):
+    return artifacts.encode_vector_shards(runtime, bundle, encoder, model={"id": "fixture"}, config={"norm_policy": "none"})
+
+
+def test_resume_after_final_commit_before_checkpoint_cleanup(tmp_path, monkeypatch):
+    runtime = _input(tmp_path)
+    bundle = tmp_path / "bundle"
+    writer = artifacts._atomic_write_json
+
+    def interrupted(path, payload):
+        writer(path, payload)
+        if path.name == "manifest.json":
+            raise RuntimeError("crash after final commit")
+
+    with monkeypatch.context() as patch:
+        patch.setattr(artifacts, "_atomic_write_json", interrupted)
+        with pytest.raises(RuntimeError, match="after final commit"):
+            _encode(runtime, bundle, Encoder())
+    assert (bundle / "manifest.partial.json").exists()
+    resumed = Encoder()
+    assert _encode(runtime, bundle, resumed)["status"] == "complete"
+    assert resumed.calls == 0
+    assert not (bundle / "manifest.partial.json").exists()
+    assert artifacts.load_vector_bundle(bundle).document_ids == ("a",)
+
+
+def test_committed_bundle_rejects_foreign_checkpoint_and_parent(tmp_path):
+    runtime = _input(tmp_path)
+    bundle = tmp_path / "bundle"
+    _encode(runtime, bundle, Encoder())
+    path = bundle / "manifest.json"
+    manifest = json.loads(path.read_text())
+    checkpoint = {**manifest, "status": "partial", "input_sha256": "0" * 64}
+    (bundle / "manifest.partial.json").write_text(json.dumps(checkpoint))
+    with pytest.raises(artifacts.VectorArtifactError, match="partial"):
+        artifacts.load_vector_bundle(bundle)
+    (bundle / "manifest.partial.json").unlink()
+    shard = manifest["shards"][0]
+    shard["model_sha256"] = "0" * 64
+    (bundle / shard["manifest_file"]).write_text(json.dumps(shard))
+    path.write_text(json.dumps(manifest))
+    with pytest.raises(artifacts.VectorArtifactError, match="binding"):
+        artifacts.load_vector_bundle(bundle)
+
+
+def _hold_writer_lock(root, ready):
+    from pathlib import Path
+    with artifacts._writer_lock(Path(root)):
+        ready.set()
+        # Parent terminates this owned process to simulate a crash.
+        ready.wait(20)
+        import time
+        time.sleep(20)
+
+
+def test_writer_collision_and_process_crash_release(tmp_path):
+    runtime = _input(tmp_path)
+    bundle = tmp_path / "bundle"
+    bundle.mkdir()
+    context = multiprocessing.get_context("spawn")
+    ready = context.Event()
+    worker = context.Process(target=_hold_writer_lock, args=(str(bundle), ready))
+    worker.start()
+    try:
+        assert ready.wait(10), "child writer did not acquire lock"
+        untouched = Encoder()
+        with pytest.raises(artifacts.VectorArtifactError, match="active writer"):
+            _encode(runtime, bundle, untouched)
+        assert untouched.calls == 0
+    finally:
+        worker.terminate()
+        worker.join(10)
+    assert not worker.is_alive()
+    assert _encode(runtime, bundle, Encoder())["status"] == "complete"
