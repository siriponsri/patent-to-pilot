n+\n+\n def _atomic_write_bytes(path: Path, payload: bytes) -> None:\n     path.parent.mkdir(parents=True, exist_ok=True)\n     temporary = path.with_name(path.name + ".partial")\n@@ -302,6 +339,9 @@ def _read_ids(path: Path) -> list[dict[str, str]]:\n\n def _shard_binding(root: Path, shard: Mapping[str, Any], parent: Mapping[str, Any]) -> tuple[list[dict[str, str]], Any]:\n     np = _numpy()\n+    for child_key, parent_key in (("parent_input_sha256", "input_sha256"), ("model_sha256", "model_sha256"), ("config_sha256", "config_sha256")):\n+        if shard.get(child_key) != parent.get(parent_key):\n+            raise VectorArtifactError(f"shard parent binding mismatch: {child_key}")\n     ids_path = _safe_child(root, str(shard["ids_file"]))\n     vectors_path = _safe_child(root, str(shard["vectors_file"]))\n     manifest_path = _safe_child(root, str(shard["manifest_file"]))\n@@ -367,9 +407,15 @@ def load_vector_bundle(bundle_dir: str | Path) -> VectorBundle:\n     manifest_path = root / "manifest.json"\n     if not manifest_path.is_file():\n         raise VectorArtifactError("bundle manifest is missing")\n-    if list(root.glob("*.partial")) or list(root.glob("*.partial.*")) or (root / "manifest.partial.json").exists():\n+    checkpoint_path = root / "manifest.partial.json"\n+    partial_artifacts = set(root.glob("*.partial")) | set(root.glob("*.partial.*"))\n+    if partial_artifacts - {checkpoint_path}:\n         raise VectorArtifactError("partial bundle artifacts are not importable")\n     manifest = json.loads(manifest_path.read_text(encoding="utf-8"))\n+    if checkpoint_path.exists():\n+        checkpoint = json.loads(checkpoint_path.read_text(encoding="utf-8"))\n+        if not isinstance(checkpoint, dict) or checkpoint.get("status") != "partial" or {**checkpoint, "status": "complete"} != manifest:\n+            raise VectorArtifactError("partial checkpoint does not match committed bundle")\n     if manifest.get("format") != FORMAT or manifest.get("status") != "complete":\n         raise VectorArtifactError("bundle manifest is not a completed vector bundle")\n     if not isinstance(manifest.get("shards"), list) or not manifest["shards"]:\n@@ -420,7 +466,7 @@ def _verify_existing_shard(root: Path, shard: Mapping[str, Any], parent: Mapping\n     _shard_binding(root, shard, parent)\n\n\n-def encode_vector_shards(\n+def _encode_vector_shards_locked(\n     input_path: str | Path,\n     output_dir: str | Path,\n     encoder: Encoder,\n@@ -451,6 +497,9 @@ def encode_vector_shards(\n             if existing.get(key) != parent.get(key):\n                 raise VectorArtifactError(f"existing bundle binding mismatch: {key}")\n         load_vector_bundle(root)\n+        # A crash may occur after the atomic final commit but before cleanup.\n+        # The loader has checked that the leftover checkpoint matches exactly.\n+        partial_manifest_path.unlink(missing_ok=True)\n         return existing\n     if partial_manifest_path.exists():\n         existing = json.loads(partial_manifest_path.read_text(encoding="utf-8"))\n@@ -554,3 +603,25 @@ class PrecomputedVectorRetriever:\n             }\n             for row in rows\n         ], int(token_count)\n+\n+\n+def encode_vector_shards(\n+    input_path: str | Path,\n+    output_dir: str | Path,\n+    encoder: Encoder,\n+    *,\n+    model: Mapping[str, Any],\n+    config: Mapping[str, Any],\n+    batch_size: int = 32,\n+    shard_size: int = 5000,\n+    stop_after_shards: int | None = None,\n+) -> dict[str, Any]:\n+    """Encode/resume with one process-owned writer for the entire bundle."""\n+    root = Path(output_dir).resolve()\n+    root.mkdir(parents=True, exist_ok=True)\n+    with _writer_lock(root):\n+        return _encode_vector_shards_locked(\n+            input_path, root, encoder, model=model, config=config,\n+            batch_size=batch_size, shard_size=shard_size,\n+            stop_after_shards=stop_after_shards,\n+        )\ndiff --git a/src/patent_to_pilot/healthtech/engine.py b/src/patent_to_pilot/healthtech/engine.py\nindex b876d58..4ac6a6d 100644\n--- a/src/patent_to_pilot/healthtech/engine.py\n+++ b/src/patent_to_pilot/healthtech/engine.py\n@@ -22,6 +22,7 @@ from patent_to_pilot.healthtech.rights import (\n     enforce_dossier_rights,\n     limit_displayable_payload,\n     project_evidence,\n+    project_company_metadata,\n     source_rights_summary,\n )\n from patent_to_pilot.ingestion.pls import PatentDocument\n@@ -374,7 +375,11 @@ def serialize_dossier(\n                 f"External export omitted payload for source {source.source.source_id}: no reviewed displayable mapping."\n             )\n     payload["evidence"] = [item.model_dump(mode="json") for item in evidence]\n+    company_metadata, company_diagnostics = project_company_metadata(\n+        dossier.query, dossier.sources, purpose=purpose\n+    )\n+    payload["query"]["company_metadata"] = company_metadata\n     payload["unresolved_items"] = (\n-        list(payload["unresolved_items"]) + evidence_diagnostics + source_diagnostics\n+        list(payload["unresolved_items"]) + evidence_diagnostics + source_diagnostics + company_diagnostics\n     )\n     return payload\ndiff --git a/src/patent_to_pilot/healthtech/rights.py b/src/patent_to_pilot/healthtech/rights.py\nindex 23b64a6..edeab50 100644\n--- a/src/patent_to_pilot/healthtech/rights.py\n+++ b/src/patent_to_pilot/healthtech/rights.py\n@@ -7,6 +7,7 @@ from typing import Any, Literal\n\n from patent_to_pilot.healthtech.contracts import (\n     DossierVersion,\n+    DeviceQuery,\n     EvidenceItem,\n     SourcePayload,\n     SourceRights,\n@@ -274,3 +275,39 @@ def project_evidence(\n def enforce_dossier_rights(dossier: DossierVersion, *, purpose: ExportPurpose) -> None:\n     for source in dossier.sources:\n         enforce_source_rights(source, purpose=purpose)\n+\n+\n+def project_company_metadata(\n+    query: DeviceQuery,\n+    sources: list[SourcePayload],\n+    *,\n+    purpose: ExportPurpose,\n+) -> tuple[dict[str, str], list[str]]:\n+    """Keep external source-derived query fields within the source policy.\n+\n+    Company metadata has an explicit source basis; a copied value must not\n+    bypass the same field boundary applied to that source's payload/evidence.\n+    User edits have their own authored origin and are left untouched.\n+    """\n+    metadata = dict(query.company_metadata)\n+    if purpose == "local_research" or not metadata:\n+        return metadata, []\n+    source = next((item for item in sources if item.source.source_id == query.company_source_id), None)\n+    if source is None:\n+        return {}, ["External export omitted company metadata: source basis is unavailable."]\n+    if source.synthetic:\n+        return metadata, []\n+    enforce_source_rights(source, purpose=purpose)\n+    projected: dict[str, str] = {}\n+    diagnostics: list[str] = []\n+    for field, value in metadata.items():\n+        try:\n+            enforce_displayable_field(source, field, purpose=purpose)\n+            source_value = _field_value(source.payload, field)\n+            if not isinstance(source_value, str) or source_value != value:\n+                raise KeyError(field)\n+        except (KeyError, RightsBoundaryError):\n+            diagnostics.append("External export omitted company metadata field: no matching reviewed source field.")\n+            continue\n+        projected[field] = source_value\n+    return projected, diagnostics\ndiff --git a/tests/test_healthtech_query_projection.py b/tests/test_healthtech_query_projection.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/test_healthtech_query_projection.py\n@@ -0,0 +1,47 @@\n+"""Offline regressions for the source-derived query metadata channel."""\n+import json\n+from pathlib import Path\n+\n+import pytest\n+\n+from patent_to_pilot.healthtech.abbott import build_abbott_case_inputs\n+from patent_to_pilot.healthtech.engine import run_dossier, serialize_dossier, export_markdown\n+from patent_to_pilot.healthtech.history import save_version, select_version\n+from test_healthtech_repairs import _write_synthetic_abbott_cohort, _write_json\n+\n+ROOT = Path(__file__).resolve().parents[1]\n+\n+\n+@pytest.mark.parametrize("purpose", ["product_display", "redistribution"])\n+def test_external_query_metadata_follows_source_field_policy_after_reload(tmp_path, purpose):\n+    cohort = _write_synthetic_abbott_cohort(tmp_path)\n+    policies = json.loads((ROOT / "docs/healthtech/audits/luna-patent-dossiers-20261028-rights-cohort/rights-matrix.json").read_text())\n+    for policy in policies["sources"]:\n+        policy["intended_use"]["product_display"] = "ALLOWED"\n+        policy["intended_use"]["redistribution"] = "ALLOWED"\n+        policy["displayable_fields"] = ["trade_name"] if policy["source_id"] == "openfda-pma-records" else []\n+    path = tmp_path / "rights.json"\n+    _write_json(path, policies)\n+    data = next(iter(build_abbott_case_inputs(cohort, rights_matrix_path=path).values()))\n+    original = dict(data.query.company_metadata)\n+    assert original["applicant"] == "ABBOTT MEDICAL"\n+    query = data.query.model_copy(update={"company_metadata": {**original, "trade_name": "MitraClip", "unknown": "RESTRICTED-SENTINEL"}})\n+    data = data.model_copy(update={"query": query})\n+    dossier, _, _ = run_dossier(data, run_id="query-boundary", code_commit="test")\n+    dossier = dossier.model_copy(update={"user_edits": {"notes": "independently authored note"}})\n+    history = tmp_path / "history"\n+    save_version(history, dossier)\n+    restored = select_version(history)\n+    local = serialize_dossier(restored)\n+    external = serialize_dossier(restored, purpose=purpose)\n+    assert local["query"]["company_metadata"] == dict(query.company_metadata)\n+    assert external["query"]["company_metadata"] == {"trade_name": "MitraClip"}\n+    assert external["user_edits"] == local["user_edits"]\n+    assert "RESTRICTED-SENTINEL" not in json.dumps(external)\n+    for language in ("en", "th"):\n+        assert "RESTRICTED-SENTINEL" not in export_markdown(restored, language=language, purpose=purpose)\n+\n+    forged = restored.model_copy(update={"query": query.model_copy(update={"company_metadata": {"trade_name": "wrong source value"}})})\n+    assert serialize_dossier(forged, purpose=purpose)["query"]["company_metadata"] == {}\n+    missing = restored.model_copy(update={"query": query.model_copy(update={"company_source_id": "missing"})})\n+    assert serialize_dossier(missing, purpose=purpose)["query"]["company_metadata"] == {}\ndiff --git a/tests/test_healthtech_vector_restart.py b/tests/test_healthtech_vector_restart.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/test_healthtech_vector_restart.py\n@@ -0,0 +1,102 @@\n+"""Authored offline crash/concurrency cases for actual publication boundaries."""\n+import json\n+import multiprocessing\n+\n+import numpy as np\n+import pytest\n+\n+from patent_to_pilot.evaluation.healthtech import vector_artifacts as artifacts\n+\n+\n+class Encoder:\n+    def __init__(self):\n+        self.calls = 0\n+\n+    def encode(self, texts):\n+        self.calls += 1\n+        return np.asarray([[1.0, 0.0] for _ in texts], dtype="<f4"), len(texts)\n+\n+\n+def _input(tmp_path):\n+    path = tmp_path / "runtime.jsonl"\n+    artifacts.export_runtime_text(\n+        [{"item_id": "a", "text": "authored public test"}], path,\n+        dataset_id="fixture", source_revision="r1", representation="text",\n+    )\n+    return path\n+\n+\n+def _encode(runtime, bundle, encoder):\n+    return artifacts.encode_vector_shards(runtime, bundle, encoder, model={"id": "fixture"}, config={"norm_policy": "none"})\n+\n+\n+def test_resume_after_final_commit_before_checkpoint_cleanup(tmp_path, monkeypatch):\n+    runtime = _input(tmp_path)\n+    bundle = tmp_path / "bundle"\n+    writer = artifacts._atomic_write_json\n+\n+    def interrupted(path, payload):\n+        writer(path, payload)\n+        if path.name == "manifest.json":\n+            raise RuntimeError("crash after final commit")\n+\n+    with monkeypatch.context() as patch:\n+        patch.setattr(artifacts, "_atomic_write_json", interrupted)\n+        with pytest.raises(RuntimeError, match="after final commit"):\n+            _encode(runtime, bundle, Encoder())\n+    assert (bundle / "manifest.partial.json").exists()\n+    resumed = Encoder()\n+    assert _encode(runtime, bundle, resumed)["status"] == "complete"\n+    assert resumed.calls == 0\n+    assert not (bundle / "manifest.partial.json").exists()\n+    assert artifacts.load_vector_bundle(bundle).document_ids == ("a",)\n+\n+\n+def test_committed_bundle_rejects_foreign_checkpoint_and_parent(tmp_path):\n+    runtime = _input(tmp_path)\n+    bundle = tmp_path / "bundle"\n+    _encode(runtime, bundle, Encoder())\n+    path = bundle / "manifest.json"\n+    manifest = json.loads(path.read_text())\n+    checkpoint = {**manifest, "status": "partial", "input_sha256": "0" * 64}\n+    (bundle / "manifest.partial.json").write_text(json.dumps(checkpoint))\n+    with pytest.raises(artifacts.VectorArtifactError, match="partial"):\n+        artifacts.load_vector_bundle(bundle)\n+    (bundle / "manifest.partial.json").unlink()\n+    shard = manifest["shards"][0]\n+    shard["model_sha256"] = "0" * 64\n+    (bundle / shard["manifest_file"]).write_text(json.dumps(shard))\n+    path.write_text(json.dumps(manifest))\n+    with pytest.raises(artifacts.VectorArtifactError, match="binding"):\n+        artifacts.load_vector_bundle(bundle)\n+\n+\n+def _hold_writer_lock(root, ready):\n+    from pathlib import Path\n+    with artifacts._writer_lock(Path(root)):\n+        ready.set()\n+        # Parent terminates this owned process to simulate a crash.\n+        ready.wait(20)\n+        import time\n+        time.sleep(20)\n+\n+\n+def test_writer_collision_and_process_crash_release(tmp_path):\n+    runtime = _input(tmp_path)\n+    bundle = tmp_path / "bundle"\n+    bundle.mkdir()\n+    context = multiprocessing.get_context("spawn")\n+    ready = context.Event()\n+    worker = context.Process(target=_hold_writer_lock, args=(str(bundle), ready))\n+    worker.start()\n+    try:\n+        assert ready.wait(10), "child writer did not acquire lock"\n+        untouched = Encoder()\n+        with pytest.raises(artifacts.VectorArtifactError, match="active writer"):\n+            _encode(runtime, bundle, untouched)\n+        assert untouched.calls == 0\n+    finally:\n+        worker.terminate()\n+        worker.join(10)\n+    assert not worker.is_alive()\n+    assert _encode(runtime, bundle, Encoder())["status"] == "complete"\n