{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored HealthTech UX fixture envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authored_synthetic",
    "disclaimer",
    "capabilities",
    "synthetic_dossier",
    "empty_corpus_dossier",
    "overlay",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "ux-fixtures-v1"
    },
    "authored_synthetic": {
      "const": true
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterId",
        "mode",
        "deviceCatalog",
        "packageImport",
        "sourceInspect",
        "runStart",
        "runControl",
        "localDrafts",
        "backendHistory",
        "export",
        "collaboration",
        "analytics"
      ],
      "properties": {
        "deviceCatalog": {
          "type": "boolean"
        },
        "packageImport": {
          "type": "boolean"
        },
        "sourceInspect": {
          "type": "boolean"
        },
        "runStart": {
          "type": "boolean"
        },
        "localDrafts": {
          "type": "boolean"
        },
        "backendHistory": {
          "type": "boolean"
        },
        "collaboration": {
          "type": "boolean"
        },
        "analytics": {
          "type": "boolean"
        },
        "adapterId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "synthetic_demo"
        },
        "runControl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cancel",
            "resume",
            "retry"
          ],
          "properties": {
            "cancel": {
              "type": "boolean"
            },
            "resume": {
              "type": "boolean"
            },
            "retry": {
              "type": "boolean"
            }
          }
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recoveryJson",
            "editedMarkdown",
            "pdf",
            "docx"
          ],
          "properties": {
            "recoveryJson": {
              "type": "boolean"
            },
            "editedMarkdown": {
              "type": "boolean"
            },
            "pdf": {
              "type": "boolean"
            },
            "docx": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "synthetic_dossier": {
      "type": "object",
      "description": "Validated separately against actual DossierVersion JSON schema and semantic source-integrity checks."
    },
    "empty_corpus_dossier": {
      "type": "object",
      "description": "Validated separately against actual DossierVersion contract."
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notes",
        "featureLinks",
        "requestDrafts"
      ],
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "noteId",
              "targetRef",
              "baseDossierVersion",
              "text",
              "basis",
              "reviewMarker"
            ],
            "properties": {
              "noteId": {
                "type": "string"
              },
              "targetRef": {
                "type": "string"
              },
              "baseDossierVersion": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string"
              },
              "basis": {
                "const": "user_note"
              },
              "reviewMarker": {
                "enum": [
                  "needs_clarification",
                  "disputed_basis",
                  "reviewed_note"
                ]
              }
            }
          }
        },
        "featureLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature",
              "evidenceIds",
              "basis"
            ],
            "properties": {
              "feature": {
                "type": "string"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "basis": {
                "const": "user_authored"
              }
            }
          }
        },
        "requestDrafts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestId",
              "question",
              "evidenceRefs",
              "priority",
              "intendedRole",
              "status"
            ],
            "properties": {
              "requestId": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "priority": {
                "enum": [
                  "low",
                  "normal",
                  "high"
                ]
              },
              "intendedRole": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "draft",
                  "done_by_user"
                ]
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "mode",
          "kind",
          "stateIds",
          "screenIds",
          "payloadRef",
          "expected",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FX-[0-9]{2}$"
          },
          "title": {
            "type": "string"
          },
          "mode": {
            "const": "simulation"
          },
          "kind": {
            "enum": [
              "positive",
              "negative",
              "simulation"
            ]
          },
          "stateIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^ST-[0-9]{2}$"
            }
          },
          "screenIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^SCR-[0-9]{2}$"
            }
          },
          "payloadRef": {
            "enum": [
              "synthetic_dossier",
              "empty_corpus_dossier"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object"
          }
        }
      }
    }
  }
}
