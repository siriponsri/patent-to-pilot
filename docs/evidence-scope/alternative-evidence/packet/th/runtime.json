{
  "sources": [
    {
      "source_id": "ae-th-basketry-doc",
      "version": "1",
      "language": "th",
      "family_id": "ae-th-basketry",
      "text": "ข้อ ๓ งานยืมตะกร้าไปจัดแสดงให้ส่งที่โต๊ะริมประตู จุดรับนี้ใช้กับผู้ส่งตามบัญชี ก เท่านั้น\n\nข้อ ๔ งานฝากตะกร้าเพื่อสาธิตให้ส่งที่โต๊ะริมประตู จุดรับนี้ใช้กับผู้ส่งตามบัญชี ข เท่านั้น\n\nบัญชี ก ผู้ส่งที่ลงทะเบียนในประเภทโรงเรียนใช้ช่องทางยืมตะกร้าไปจัดแสดง\n\nบัญชี ข ผู้ส่งที่ลงทะเบียนในประเภทกลุ่มช่างจักสานใช้ช่องทางฝากตะกร้าเพื่อสาธิต\n\nข้อ ๖ เจ้าหน้าที่ตรวจสภาพตะกร้าก่อนนำเข้าหอ\n",
      "sha256": "0845a3ba79d87ddabb33c878b132d47d702be1ed4a017c44eff965103df19f4e"
    },
    {
      "source_id": "ae-th-darkroom-doc",
      "version": "1",
      "language": "th",
      "family_id": "ae-th-darkroom",
      "text": "บัตรฟิล์ม ๑ กำหนดเวลาส่งฟิล์มของกะเช้าไว้ในตารางสีครามช่อง ก\n\nบัตรฟิล์ม ๒ กำหนดเวลาส่งฟิล์มของกะบ่ายไว้ในสมุดฉายภาพบรรทัด ๒\n\nตารางสีคราม ช่อง ก ส่งฟิล์มภายในสิบเจ็ดนาฬิกา\n\nสมุดฉายภาพ บรรทัด ๒ ปิดรับฟิล์มเวลา สิบเจ็ดนาฬิกา\n\nบัตรอุปกรณ์ เมื่อปิดห้องให้เก็บคีมลงกล่อง\n",
      "sha256": "b415b7a1fc6a5422b272d67aad7e9eb38018e12327ecc2eb270a51b0965135fd"
    },
    {
      "source_id": "ae-th-rain-gauge-doc",
      "version": "1",
      "language": "th",
      "family_id": "ae-th-rain-gauge",
      "text": "ข้อถือสิทธิ ๑ ฐานมาตรวัดฝนรุ่นกรวดสำหรับพื้นคอนกรีต\n\nข้อถือสิทธิ ๒ ฐานตามข้อถือสิทธิ ๑ มีตัวยึดกระบอกเป็นวงแหวนเกลียว\n\nข้อถือสิทธิ ๓ ฐานมาตรวัดฝนรุ่นใบไม้สำหรับพื้นคอนกรีต ใช้ตัวยึดกระบอกแบบวงแหวนเกลียว\n\nข้อถือสิทธิ ๔ ฐานตามข้อถือสิทธิ ๑ มียางรองใต้ขา\n\nข้อถือสิทธิ ๕ ฐานมาตรวัดฝนรุ่นสายฝนสำหรับพื้นไม้ ใช้ตัวยึดกระบอกแบบเหล็กแผ่นพับ\n",
      "sha256": "9d9ba8a9e34010f5c1b7cfb8e3d752f14273922f5006a83b3620aca236ed6f8e"
    },
    {
      "source_id": "ae-th-weir-doc",
      "version": "คราม",
      "language": "th",
      "family_id": "ae-th-weir",
      "text": "ข้อ ๒ ฉบับคราม ให้เปิดช่องระบายเช้าวันพุธตามเงื่อนไขข้อ ๑\n\nข้อ ๑ คู่มือนี้ใช้เฉพาะอ่างตะวันออก\n",
      "sha256": "81a613c7d49f4f7ffd1edcf2b8c3960f407e86423d297975e68b1814e73102b5"
    },
    {
      "source_id": "ae-th-weir-doc",
      "version": "เทา",
      "language": "th",
      "family_id": "ae-th-weir",
      "text": "ข้อ ๔ ฉบับเทา ยกเลิกข้อ ๒ ของฉบับคราม ให้ใช้เวลาตามช่อง ต ในใบแนบ และคงเขตอ่างตามข้อ ๑ ของฉบับครามไว้\n\nใบแนบ ช่อง ต เวลาเปิดช่องระบายคือเช้าวันพุธ\n\nข้อ ๕ ให้เก็บสมุดเวรไว้ใกล้มาตรวัด\n",
      "sha256": "cf11046168cc4e2cb266eda8eec5622adb3bf7c311def4d549d7cbc9d07ed11c"
    },
    {
      "source_id": "ae-th-lantern-maps-doc",
      "version": "1",
      "language": "th",
      "family_id": "ae-th-lantern-maps",
      "text": "ข้อ ๘ ชุดโคมประเภทออกเดินให้คืนที่ศาลาเหนือ ผู้คืนต้องอยู่ในรอบที่บันทึกไว้ในใบเดินทาง\n\nข้อ ๙ ชุดโคมประเภทซ้อมให้คืนที่โรงเก็บสี ผู้คืนต้องอยู่ในรอบที่บันทึกไว้ในใบฝึก\n\nใบเดินทาง ให้ดูเวลาคืนในตารางบัตรดาว\n\nใบฝึก ให้ดูเวลาคืนที่บัตรบนสายคล้องผ้า\n\nตารางบัตรดาว กำหนดเวลาคืนเป็นรอบบ่าย\n\nบัตรบนสายคล้องผ้า กำหนดเวลาคืนเป็นรอบบ่าย\n\nข้อ ๑๐ ชุดโคมประเภทสำรองรอบหัวค่ำให้คืนที่หอหน้าลาน\n",
      "sha256": "9ee57b1c48fe33042a0906ee139551656bd218992ecaf9ce6322f4a3e2b705bd"
    },
    {
      "source_id": "ae-th-seed-storage-doc",
      "version": "1",
      "language": "th",
      "family_id": "ae-th-seed-storage",
      "text": "หน้าคลัง บรรทัด ๓ ซองฝากชั่วคราวต้องวางที่ชั้นไม้ล่าง ให้ตรวจลักษณะซองจากใบรับฝาก\n\nป้ายหน้าโต๊ะ ซองฝากชั่วคราวต้องวางที่ชั้นไม้ล่าง ใช้คำจำกัดความตามใบรับฝาก\n\nใบรับฝาก ซองฝากชั่วคราวคือซองที่ประทับตราวงกลม\n\nหน้าคลัง บรรทัด ๔ ซองฝากถาวรที่มีตราสามเหลี่ยมวางที่ตู้เหล็ก\n\nท้ายสมุด ตรวจจำนวนซองก่อนปิดคลัง\n",
      "sha256": "602bdb8170656c807f1ccb4f4d25ef3e806c30aa090397d21da94f9350d8aead"
    },
    {
      "source_id": "ae-th-pencil-library-doc",
      "version": "1",
      "language": "th",
      "family_id": "ae-th-pencil-library",
      "text": "ข้อ ค กำหนดจำนวนวันที่ยืมได้สำหรับชุดดินสอสีในใบกำหนดคืน\n\nใบกำหนดคืน ระยะเวลายืมสามวัน\n\nข้อ ง ให้เหลาดินสอเมื่อปลายทู่\n\nช่องสำรอง สำหรับจดรายการสีที่หาย\n",
      "sha256": "f8b81a39f86dffd028243f5ecaf17a4f2b75eb4032206f6ac60f271178772ba6"
    },
    {
      "source_id": "ae-th-ferry-crates-doc",
      "version": "ใบตอง",
      "language": "th",
      "family_id": "ae-th-ferry-crates",
      "text": "ข้อ ๑ ฉบับใบตอง ลังขนาดเล็กให้ส่งที่ประตูฟ้า\n",
      "sha256": "41bb1cc2a2fa8a7e800a3de6461ff68181bdf92b424ce62b247f51f0ed54ddaf"
    },
    {
      "source_id": "ae-th-ferry-crates-doc",
      "version": "กาบกล้วย",
      "language": "th",
      "family_id": "ae-th-ferry-crates",
      "text": "ข้อ ๓ ฉบับกาบกล้วย ให้ยกเลิกข้อ ๑ ของฉบับใบตอง ลังขนาดเล็กให้ส่งที่ประตูตามประกาศท่า\n\nข้อ ๔ เมื่อได้ยินกระดิ่งให้หยุดขนลังชั่วคราว\n",
      "sha256": "c25031e4d7b12c0ec270b4312b0e4b2bfb0fa4853a41219b9371a381975d3cbe"
    },
    {
      "source_id": "ae-th-ferry-crates-pier",
      "version": "1",
      "language": "th",
      "family_id": "ae-th-ferry-crates",
      "text": "ประกาศท่า ช่อง ๒ ประตูส่งลังคือประตูเขียว\n",
      "sha256": "53d028021fdb14fd0e112626a93af28e5a305b96b4ecf77cd33af9c5ef1c528d"
    }
  ],
