{
  "$defs": {
    "AcquisitionBudget": {
      "additionalProperties": false,
      "properties": {
        "max_search_calls": {
          "default": 3,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Search Calls",
          "type": "integer"
        },
        "max_returned_candidates": {
          "default": 60,
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Returned Candidates",
          "type": "integer"
        },
        "accounting": {
          "const": "offline_counts",
          "default": "offline_counts",
          "title": "Accounting",
          "type": "string"
        }
      },
      "title": "AcquisitionBudget",
      "type": "object"
    },
    "DeviceQuery": {
      "additionalProperties": false,
      "properties": {
        "query_id": {
          "minLength": 1,
          "title": "Query Id",
          "type": "string"
        },
        "brief": {
          "$ref": "#/$defs/ProjectBrief"
        },
        "device_id_raw": {
          "minLength": 1,
          "title": "Device Id Raw",
          "type": "string"
        },
        "device_id_canonical": {
          "minLength": 1,
          "title": "Device Id Canonical",
          "type": "string"
        },
        "selected_comparator_source_id": {
          "minLength": 1,
          "title": "Selected Comparator Source Id",
          "type": "string"
        },
        "technical_description": {
          "minLength": 1,
          "title": "Technical Description",
          "type": "string"
        },
        "features_of_interest": {
          "items": {
            "type": "string"
          },
          "title": "Features Of Interest",
          "type": "array"
        },
        "user_questions": {
          "items": {
            "type": "string"
          },
          "title": "User Questions",
          "type": "array"
        },
        "company_metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Company Metadata",
          "type": "object"
        },
        "company_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company Source Id"
        },
        "jurisdiction": {
          "minLength": 1,
          "title": "Jurisdiction",
          "type": "string"
        },
        "evidence_cutoff": {
          "format": "date",
          "title": "Evidence Cutoff",
          "type": "string"
        },
        "permitted_inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Permitted Inputs",
          "type": "array"
        },
        "acquisition_budget": {
          "$ref": "#/$defs/AcquisitionBudget"
        }
      },
      "required": [
        "query_id",
        "brief",
        "device_id_raw",
        "device_id_canonical",
        "selected_comparator_source_id",
        "technical_description",
        "jurisdiction",
        "evidence_cutoff",
        "permitted_inputs"
      ],
      "title": "DeviceQuery",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quoted_span": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quoted Span"
        },
        "structured_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structured Field"
        },
        "structured_value": {
          "default": null,
          "title": "Structured Value"
        },
        "evidence_kind": {
          "enum": [
            "source_fact",
            "patent_disclosure",
            "reported_experiment",
            "regulatory_record",
            "trial_record",
            "system_inference",
            "unresolved"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "support_basis": {
          "minLength": 1,
          "title": "Support Basis",
          "type": "string"
        },
        "jurisdiction": {
          "minLength": 1,
          "title": "Jurisdiction",
          "type": "string"
        },
        "source_date": {
          "format": "date",
          "title": "Source Date",
          "type": "string"
        },
        "extraction_method": {
          "enum": [
            "literal_span",
            "structured_field",
            "authored_inference"
          ],
          "title": "Extraction Method",
          "type": "string"
        },
        "verification_status": {
          "default": "not_checked",
          "enum": [
            "not_checked",
            "exact_span_checked",
            "field_value_checked",
            "not_independently_validated"
          ],
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "source_version",
        "payload_hash",
        "locator",
        "evidence_kind",
        "statement",
        "support_basis",
        "jurisdiction",
        "source_date",
        "extraction_method"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "PatentCandidate": {
      "additionalProperties": false,
      "properties": {
        "patent_id_raw": {
          "title": "Patent Id Raw",
          "type": "string"
        },
        "patent_id_canonical": {
          "title": "Patent Id Canonical",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "retrieval_action_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Retrieval Action Ids",
          "type": "array"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Scores",
          "type": "object"
        },
        "association_status": {
          "default": "retrieved_candidate",
          "enum": [
            "retrieved_candidate",
            "disclosed_link"
          ],
          "title": "Association Status",
          "type": "string"
        },
        "disclosure_evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disclosure Evidence Id"
        },
        "family_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Id"
        },
        "family_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Source Id"
        }
      },
      "required": [
        "patent_id_raw",
        "patent_id_canonical",
        "source_id",
        "source_revision",
        "retrieval_action_ids",
        "scores"
      ],
      "title": "PatentCandidate",
      "type": "object"
    },
    "ProjectBrief": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "pattern": "^[A-Za-z0-9_-]{1,80}$",
          "title": "Project Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "objective": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "audience": {
          "enum": [
            "entrepreneur",
            "investor",
            "researcher"
          ],
          "title": "Audience",
          "type": "string"
        },
        "data_class": {
          "enum": [
            "synthetic",
            "public",
            "private"
          ],
          "title": "Data Class",
          "type": "string"
        },
        "language": {
          "default": "en",
          "enum": [
            "en",
            "th"
          ],
          "title": "Language",
          "type": "string"
        },
        "theme": {
          "default": "formal-light",
          "enum": [
            "formal-light",
            "formal-dark",
            "kmitl-inspired",
            "ict-inspired"
          ],
          "title": "Theme",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "version",
        "objective",
        "audience",
        "data_class"
      ],
      "title": "ProjectBrief",
      "type": "object"
    },
    "SourcePayload": {
      "additionalProperties": false,
      "properties": {
        "rights": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRights"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/SourceRecord"
        },
        "payload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "title": "Payload"
        },
        "jurisdiction": {
          "minLength": 1,
          "title": "Jurisdiction",
          "type": "string"
        },
        "source_date": {
          "format": "date",
          "title": "Source Date",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "payload",
        "jurisdiction",
        "source_date",
        "synthetic"
      ],
      "title": "SourcePayload",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "version_label": {
          "minLength": 1,
          "title": "Version Label",
          "type": "string"
        },
        "license_note": {
          "minLength": 1,
          "title": "License Note",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "limits": {
          "items": {
            "type": "string"
          },
          "title": "Limits",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "source_id",
        "source_type",
        "uri",
        "version_label",
        "license_note"
      ],
      "title": "SourceRecord",
      "type": "object"
    },
    "SourceRights": {
      "additionalProperties": false,
      "description": "Auditable rights basis carried with every non-synthetic source.",
      "properties": {
        "rights_id": {
          "minLength": 1,
          "title": "Rights Id",
          "type": "string"
        },
        "source_id_prefixes": {
          "items": {
            "type": "string"
          },
          "title": "Source Id Prefixes",
          "type": "array"
        },
        "source_types": {
          "items": {
            "type": "string"
          },
          "title": "Source Types",
          "type": "array"
        },
        "basis_url": {
          "minLength": 1,
          "title": "Basis Url",
          "type": "string"
        },
        "checked_date": {
          "format": "date",
          "title": "Checked Date",
          "type": "string"
        },
        "basis_revision": {
          "minLength": 1,
          "title": "Basis Revision",
          "type": "string"
        },
        "basis_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Basis Sha256",
          "type": "string"
        },
        "clause_locator": {
          "minLength": 1,
          "title": "Clause Locator",
          "type": "string"
        },
        "clause": {
          "minLength": 1,
          "title": "Clause",
          "type": "string"
        },
        "interpretation": {
          "minLength": 1,
          "title": "Interpretation",
          "type": "string"
        },
        "acquisition": {
          "enum": [
            "ALLOWED",
            "ALLOWED_WITH_ATTRIBUTION",
            "ALLOWED_LOCAL_SNAPSHOT",
            "ALLOWED_LOCAL_RESEARCH",
            "ALLOWED_ONLY_FOR_REVIEWED_PUBLIC_DOMAIN_FIELDS",
            "BLOCKED_LOCAL",
            "UNRESOLVED"
          ],
          "title": "Acquisition",
          "type": "string"
        },
        "local_evaluation": {
          "enum": [
            "ALLOWED",
            "ALLOWED_WITH_ATTRIBUTION",
            "ALLOWED_LOCAL_SNAPSHOT",
            "ALLOWED_LOCAL_RESEARCH",
            "ALLOWED_ONLY_FOR_REVIEWED_PUBLIC_DOMAIN_FIELDS",
            "BLOCKED_LOCAL",
            "UNRESOLVED"
          ],
          "title": "Local Evaluation",
          "type": "string"
        },
        "product_display": {
          "enum": [
            "ALLOWED",
            "ALLOWED_WITH_ATTRIBUTION",
            "ALLOWED_LOCAL_SNAPSHOT",
            "ALLOWED_LOCAL_RESEARCH",
            "ALLOWED_ONLY_FOR_REVIEWED_PUBLIC_DOMAIN_FIELDS",
            "BLOCKED_LOCAL",
            "UNRESOLVED"
          ],
          "title": "Product Display",
          "type": "string"
        },
        "redistribution": {
          "enum": [
            "ALLOWED",
            "ALLOWED_WITH_ATTRIBUTION",
            "ALLOWED_LOCAL_SNAPSHOT",
            "ALLOWED_LOCAL_RESEARCH",
            "ALLOWED_ONLY_FOR_REVIEWED_PUBLIC_DOMAIN_FIELDS",
            "BLOCKED_LOCAL",
            "UNRESOLVED"
          ],
          "title": "Redistribution",
          "type": "string"
        },
        "displayable_fields": {
          "items": {
            "type": "string"
          },
          "title": "Displayable Fields",
          "type": "array"
        },
        "limits": {
          "items": {
            "type": "string"
          },
          "title": "Limits",
          "type": "array"
        }
      },
      "required": [
        "rights_id",
        "basis_url",
        "checked_date",
        "basis_revision",
        "basis_sha256",
        "clause_locator",
        "clause",
        "interpretation",
        "acquisition",
        "local_evaluation",
        "product_display",
        "redistribution"
      ],
      "title": "SourceRights",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "dossier_id": {
      "title": "Dossier Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "parent_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Version"
    },
    "query": {
      "$ref": "#/$defs/DeviceQuery"
    },
    "input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourcePayload"
      },
      "title": "Sources",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/PatentCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "unresolved_items": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Items",
      "type": "array"
    },
    "next_information_requests": {
      "items": {
        "type": "string"
      },
      "title": "Next Information Requests",
      "type": "array"
    },
    "user_edits": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "User Edits",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "validation_scope": {
      "const": "source_integrity_only",
      "default": "source_integrity_only",
      "title": "Validation Scope",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "dossier_id",
    "version",
    "query",
    "input_hash",
    "sources",
    "evidence",
    "candidates",
    "unresolved_items",
    "next_information_requests",
    "run_id",
    "created_at"
  ],
  "title": "DossierVersion",
  "type": "object"
}
