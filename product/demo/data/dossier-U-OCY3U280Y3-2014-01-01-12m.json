  "claims": [
    {
      "id": "queue",
      "section": "decision",
      "text_th": "อยู่ในคิวตรวจทบทวน · ลำดับ 3 จาก 544 รายการ และรับตรวจได้ 108 รายการ ใช้ทบทวนข้อมูลก่อนตัดสินใจพัฒนา",
      "text_en": "Rank 3 of 544, in the queue of 108 slots. Use the evidence to plan the next development review.",
      "source_ids": [
        "freeze-score"
      ],
      "state": "known",
      "kind": "estimate"
    },
    {
      "id": "entry",
      "section": "market",
      "text_th": "โอกาสได้รับอนุมัติ ANDA ขั้นสุดท้ายครั้งแรกภายใน 12 เดือน M3 13.1% และเกณฑ์เทียบตามอายุยา B1 12.2% วันอนุมัติและวันเริ่มจำหน่ายเป็นคนละเหตุการณ์",
      "text_en": "Estimated first final ANDA approval within 12 months: M3 13.1%; drug-age baseline B1 12.2%. Approval and marketing are separate events.",
      "source_ids": [
        "freeze-score"
      ],
      "state": "known",
      "kind": "estimate"
    },
    {
      "id": "approved-applicants",
      "section": "competition",
      "text_th": "พบผู้ยื่น ANDA ที่ได้รับอนุมัติขั้นสุดท้ายก่อนหรือ ณ วันตัดข้อมูล 0 ราย ในกลุ่มตัวยาสำคัญที่เชื่อมโยงได้ จำนวนผู้ผลิตที่วางจำหน่ายยังไม่ทราบ",
      "text_en": "Zero distinct final ANDA applicants in linked records through the cutoff, as required for eligibility. Marketed producer count is unknown.",
      "source_ids": [
        "anda-at-risk",
        "freeze-score"
      ],
      "state": "known",
      "kind": "observed"
    },
    {
      "id": "price-scenario",
      "section": "market",
      "text_th": "สมมติฐานย้อนหลังจาก FDA ปี 2019 หากมีผู้ผลิตยาสามัญวางจำหน่าย 2, 3 หรือ 4 ราย ราคาเฉลี่ยผู้ผลิต (AMP) ของยาสามัญเท่ากับ 46.5%, 32.2% หรือ 21.2% ของ AMP ยาต้นแบบก่อนมียาสามัญตามลำดับ ยังไม่มีราคาอ้างอิงเพื่อคำนวณราคาของยานี้",
      "text_en": "Retrospective scenario from the FDA's 2019 study. With 2, 3 or 4 marketed generic producers, assume generic average manufacturer price (AMP) of 46.5%, 32.2% or 21.2% of the pre-entry brand AMP, respectively. The implied price is unknown without a documented brand AMP.",
      "source_ids": [
        "fda-amp-2019"
      ],
      "state": "known",
      "kind": "assumption",
      "time_basis": "retrospective_scenario"
    },
    {
      "id": "demand",
      "section": "market",
      "text_th": "ยังไม่ทราบความต้องการย้อนหลังจาก Medicaid ไตรมาส 2 ปี 2013 เพราะไม่พบกลุ่มรหัสบรรจุภัณฑ์ที่เชื่อมโยงได้และมีจำนวนใบสั่งยาครบ",
      "text_en": "Retrospective Medicaid 2013 Q2 baseline is unknown. No exact linked package subset has complete prescription counts in the available vintage.",
      "source_ids": [
        "sdud",
        "sdud-ndc"
      ],
      "state": "unknown",
      "kind": "observed",
      "time_basis": "retrospective_demand"
    },
